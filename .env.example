# ── BuildBase org (console.buildbase.app) ──
NEXT_PUBLIC_BUILDBASE_SERVER_URL=https://api.console.buildbase.app
NEXT_PUBLIC_BUILDBASE_ORG_ID=<24-char-hex-org-id>

# ── Agent / MCP stack ──
# Public origin of this app (used in every discovery document + token audience).
# Must be reachable by the BuildBase platform — localhost will not work.
NEXT_PUBLIC_SITE_URL=https://<your-public-origin>
# Secret of the OAuth2 BASE client (Type oauth2, kind "Agent") — the platform
# signs applicationTokenUrl/RevokeUrl calls with it.
BUILDBASE_AGENT_CLIENT_SECRET=<oauth2-base-client-secret>
# App-owned token-signing secret (HS256 + sid encryption). Generate:
#   openssl rand -hex 32
SYSTEM_SECRET=<random-32-byte-hex>
# Shown in /security.txt and /.well-known/security.txt (RFC 9116)
SECURITY_CONTACT_EMAIL=<security-contact@your-domain.com>
